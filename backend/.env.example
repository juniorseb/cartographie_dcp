# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/artci_dcp
SQLALCHEMY_TRACK_MODIFICATIONS=False

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Email / SMTP — reception des mails (inscription, validation, etc.)
# ============================================================
# Option A — Gmail (recommande pour les tests) :
#   1. Activer la validation en 2 etapes sur le compte Google
#   2. Generer un "mot de passe d'application" : https://myaccount.google.com/apppasswords
#   3. Mettre ce mot de passe dans MAIL_PASSWORD (16 caracteres, sans espaces)
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=True
#
# Option B — SMTP SSL (port 465) :
#   MAIL_PORT=465  MAIL_USE_TLS=False  MAIL_USE_SSL=True
#
# Option C — Serveur SMTP ARTCI / autre fournisseur (SendGrid, AWS SES, OVH...) :
#   Renseigner MAIL_SERVER / MAIL_PORT fournis par le prestataire.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application
MAIL_DEFAULT_SENDER=noreply@artci.ci
MAIL_TIMEOUT=15
# Mettre True pour DESACTIVER l'envoi reel et logger les mails en console (dev)
MAIL_SUPPRESS_SEND=False

# URL du frontend (liens dans les emails : verification RL, etc.)
FRONTEND_URL=http://localhost:5173

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=6

# File Upload
MAX_CONTENT_LENGTH=10485760  # 10 MB
UPLOAD_FOLDER=uploads

# Security
PASSWORD_MIN_LENGTH=8
PASSWORD_EXPIRY_DAYS=180  # 6 months
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# Pagination
ITEMS_PER_PAGE=50

# API Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
